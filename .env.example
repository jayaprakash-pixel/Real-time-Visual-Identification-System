# Copy to .env (git-ignored) and fill in. Real environment variables override this file.

# --- server ---
RTVIS_HOST=127.0.0.1                 # 0.0.0.0 only if the phone/other PCs must reach the dashboard
RTVIS_PORT=8010
RTVIS_DATA_DIR=                      # default: <repo>/data (database, signing key, evidence, reference embeddings)
RTVIS_ALLOW_SIGNUP=false             # the first account can always sign up; later ones need this true
RTVIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- camera / AI ---
RTVIS_AI_ENABLED=true
RTVIS_CAMERA_SOURCE=0                # webcam index, http://<phone-ip>:8080/video, or a video file
RTVIS_CAMERA_ID=CAM01
RTVIS_MIN_PERCENT=55                 # alert gate: minimum confidence percent (55 = AI confirmation bar)
RTVIS_COOLDOWN=30                    # seconds before the same person can alert again

# --- Supabase (persons + photos). Use the publishable (anon) key, never the service-role key. ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=missing_persons
SUPABASE_BUCKET=person-photos
RTVIS_SYNC_INTERVAL=30               # seconds between person syncs

# --- optional phone alerts (off while empty) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
