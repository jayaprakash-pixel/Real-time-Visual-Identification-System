# SentinelAI Surveillance System Configuration

# Backend REST API endpoint (leave blank or comment out to use mock mode)
# VITE_USE_MOCK=true|false. Default: mock data in `npm run dev`, the real server in a production build.
# VITE_API_BASE_URL=/api              # same origin as server/run.py (default)
# VITE_REALTIME_URL=ws://localhost:8010/alerts   # only when the frontend runs on another port (Vite dev)
# VITE_API_BASE_URL=http://localhost:8010/api
VITE_API_BASE_URL=/api

# Live camera surveillance stream (MJPEG endpoint)
# e.g., http://localhost:5000/video/stream or http://192.168.1.100:8080/video
# the server hands out a tokenized stream URL itself; leave blank unless you use a different stream
VITE_STREAM_URL=

# Real-time detection alerts channel (WebSocket or SSE)
# e.g., ws://localhost:5000/alerts or wss://api.yourdomain.com/alerts
# VITE_REALTIME_URL=ws://localhost:8010/alerts

# Supabase configuration for Missing Persons
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
